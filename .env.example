# ─────────────────────────────────────────────────────────────
#  Kopiera den här filen till ".env" och fyll i dina värden.
#  (cp .env.example .env)
#
#  OBS: Alla VITE_-variabler bakas in i den publika webbappen.
#  Lägg ALDRIG hemligheter som Resend-nyckeln här — den bor bara
#  i Supabase (se README).
# ─────────────────────────────────────────────────────────────

# Din Supabase-projekt-URL, t.ex. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon public" API-nyckel (Project Settings → API)
VITE_SUPABASE_ANON_KEY=

# Delat lösenord som släpper in er på sidan (bara en enkel grind)
VITE_SHARED_PASSWORD=byt-mig

# De två användarna. Namnen visas på knapparna "Jag är …".
VITE_USER_NAME_1=Anna
VITE_USER_NAME_2=Erik

# Bas-sökväg för GitHub Pages.
#   - Lokalt / eget domännamn:  /
#   - Projektsida på GitHub:    /<repo-namn>/   t.ex. /pokemon-approval/
# (I GitHub Actions sätts den automatiskt till /<repo-namn>/.)
VITE_BASE_PATH=/

# ─────────────────────────────────────────────────────────────
#  Följande sätts som SUPABASE-SECRETS, inte här. De listas bara
#  som referens. Se README, steget "Distribuera Edge Functions".
#
#    GMAIL_USER          = Gmail-adressen som skickar mejlen
#    GMAIL_APP_PASSWORD  = app-lösenordet från Google (16 tecken)
#    MAIL_FROM_NAME      = avsändarnamn, t.ex. "Pokémon-koordinator"
#    USER_NAME_1         = samma som VITE_USER_NAME_1
#    USER_EMAIL_1        = e-postadress till användare 1
#    USER_NAME_2         = samma som VITE_USER_NAME_2
#    USER_EMAIL_2        = e-postadress till användare 2
#    SITE_URL            = adressen till den publicerade sidan
# ─────────────────────────────────────────────────────────────
